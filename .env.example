# 模型
MEMOPILOT_CHAT_BASE_URL=https://api.deepseek.com
MEMOPILOT_CHAT_MODEL=deepseek-v4-flash
MEMOPILOT_CHAT_API_KEY=
MEMOPILOT_LLM_MAX_ITERATIONS=10
MEMOPILOT_LLM_MAX_OUTPUT_TOKENS=2048
MEMOPILOT_LLM_TIMEOUT_SECONDS=60
MEMOPILOT_LLM_THINKING_ENABLED=false

# Embedding 使用独立 Provider，避免与对话模型配置耦合
MEMOPILOT_EMBEDDING_BASE_URL=
MEMOPILOT_EMBEDDING_MODEL=
MEMOPILOT_EMBEDDING_API_KEY=
MEMOPILOT_EMBEDDING_DIMENSION=

# Redis
MEMOPILOT_REDIS_URL=redis://localhost:6379/0

# 主动唤醒；Source 与 MCP 映射写入 workspace/proactive_sources.json
MEMOPILOT_PROACTIVE_ENABLED=false
MEMOPILOT_PROACTIVE_TICK_SECONDS=300
MEMOPILOT_DRIFT_ENABLED=true
MEMOPILOT_DRIFT_MIN_INTERVAL_HOURS=3

# 飞书长连接
MEMOPILOT_FEISHU_APP_ID=
MEMOPILOT_FEISHU_APP_SECRET=
MEMOPILOT_FEISHU_ALLOW_FROM=
