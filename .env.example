MEMOPILOT_EMBEDDING_DIMENSION=

# Redis
MEMOPILOT_REDIS_URL=redis://localhost:6379/0

# 飞书长连接
MEMOPILOT_FEISHU_APP_ID=
MEMOPILOT_FEISHU_APP_SECRET=
MEMOPILOT_FEISHU_ALLOW_FROM=
