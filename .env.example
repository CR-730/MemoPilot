# 模型
MEMOPILOT_CHAT_BASE_URL=https://api.deepseek.com
MEMOPILOT_CHAT_MODEL=deepseek-v4-flash
MEMOPILOT_CHAT_API_KEY=
MEMOPILOT_LLM_MAX_ITERATIONS=10
MEMOPILOT_LLM_MAX_OUTPUT_TOKENS=2048
